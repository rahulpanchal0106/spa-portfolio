      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ACTORS\nVendor Super-Admin - logs into License Admin UI; manages clients & licenses; views history\nCustomer installer (VM) - machine code + email; register/validate; download tarball/chunks\nCI / Maintainer - runs ci_prod.sh or GitHub Actions Release; publishes hiretrack-vX.Y.Z assets\nHireTrack app (customer) - may call version/list via admin or env; updates through installer\nCron / sync job - cron/sync-releases pulls GitHub assets into local RELEASE_ASSETS_DIR",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ACTORS\nVendor Super-Admin - logs into License Admin UI; manages clients & licenses; views history\nCustomer installer (VM) - machine code + email; register/validate; download tarball/chunks\nCI / Maintainer - runs ci_prod.sh or GitHub Actions Release; publishes hiretrack-vX.Y.Z assets\nHireTrack app (customer) - may call version/list via admin or env; updates through installer\nCron / sync job - cron/sync-releases pulls GitHub assets into local RELEASE_ASSETS_DIR",
      "autoResize": true,
      "lineHeight": 1.25
    },
