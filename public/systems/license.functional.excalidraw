      "updated": 1,
      "link": null,
      "locked": false,
      "text": "B - CI / Release pipeline\nProduces HireTrack runtime tarball (not the admin app)\nci_prod.sh / ci_dev.sh | GitLab CI | .github/workflows/release.yml\nBump version | next build | pack | chunk 50MB | GitHub Release\nArtifacts: hiretrack-vX.Y.Z.tar.gz + .manifest.json + .part-NNN\nChannels: production / beta / staging (separate GitHub repos)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "B - CI / Release pipeline\nProduces HireTrack runtime tarball (not the admin app)\nci_prod.sh / ci_dev.sh | GitLab CI | .github/workflows/release.yml\nBump version | next build | pack | chunk 50MB | GitHub Release\nArtifacts: hiretrack-vX.Y.Z.tar.gz + .manifest.json + .part-NNN\nChannels: production / beta / staging (separate GitHub repos)",
      "autoResize": true,
      "lineHeight": 1.25
    },
