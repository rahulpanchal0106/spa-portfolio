      "link": null,
      "locked": false,
      "text": "F3 License lifecycle\nlicense/generate - HMAC key (email+machine+nonce)\nlicense/register - bind machine; create License\nlicense/validate - email+machineCode+version+channel\nlicense/verify - cryptographic key check\nlicense/read | update | revoke | toggle-status",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "F3 License lifecycle\nlicense/generate - HMAC key (email+machine+nonce)\nlicense/register - bind machine; create License\nlicense/validate - email+machineCode+version+channel\nlicense/verify - cryptographic key check\nlicense/read | update | revoke | toggle-status",
      "autoResize": true,
      "lineHeight": 1.25
