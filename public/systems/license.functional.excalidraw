      "locked": false,
      "text": "CI-1 Version bump\nRead latest GitHub release tag\nBump from commit subject:\n  Major: -> major\n  Feat: -> minor\n  else -> patch\nWrite package.json version + version.env",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CI-1 Version bump\nRead latest GitHub release tag\nBump from commit subject:\n  Major: -> major\n  Feat: -> minor\n  else -> patch\nWrite package.json version + version.env",
      "autoResize": true,
      "lineHeight": 1.25
    },
