      "link": null,
      "locked": false,
      "text": "A - License Admin (Next.js)\nApp: hiretrack-super-admin / license-admin\nHost historically: admin.hiretrack.in\nMongo: Admin | Client | License | History | ValidationHistory\nUI: /login | /register | /dashboard | clients CRUD\nGates installs: no valid license -> no asset URL / download",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A - License Admin (Next.js)\nApp: hiretrack-super-admin / license-admin\nHost historically: admin.hiretrack.in\nMongo: Admin | Client | License | History | ValidationHistory\nUI: /login | /register | /dashboard | clients CRUD\nGates installs: no valid license -> no asset URL / download",
      "autoResize": true,
      "lineHeight": 1.25
