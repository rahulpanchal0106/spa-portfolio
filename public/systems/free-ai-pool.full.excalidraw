    {
      "id": "pool-t",
      "type": "text",
      "x": 380,
      "y": 125,
      "width": 280,
      "height": 310,
      "text": "free-ai-pool (Node)\n\n1. Auth\n   client key / admin token\n\n2. Gateway POST /chat\n   (+ /v1/chat/completions)\n\n3. Routing + failover\n   strategy → try keys\n   cooldown on 429/402\n\n4. Admin API /api/admin/*\n   keys, settings, usage\n\n5. poolCache (in-memory)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 7,
      "version": 1,
      "versionNonce": 7,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "free-ai-pool (Node)\n\n1. Auth\n   client key / admin token\n\n2. Gateway POST /chat\n   (+ /v1/chat/completions)\n\n3. Routing + failover\n   strategy → try keys\n   cooldown on 429/402\n\n4. Admin API /api/admin/*\n   keys, settings, usage\n\n5. poolCache (in-memory)",
      "lineHeight": 1.25,
      "baseline": 280
    },
