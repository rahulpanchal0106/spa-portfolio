      "updated": 1,
      "link": null,
      "locked": false,
      "text": "NFR-S2 Cryptographic key strength\nQuality: keys not forgeable without LICENSE_SECRET\nMechanism: HMAC-SHA256(email:machineCode:nonce)\nnonce = crypto.randomBytes(8); key = nonce + digest[0:24]\nverifyLicenseKey uses crypto.timingSafeEqual\nNever commit LICENSE_SECRET; no default in prod",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NFR-S2 Cryptographic key strength\nQuality: keys not forgeable without LICENSE_SECRET\nMechanism: HMAC-SHA256(email:machineCode:nonce)\nnonce = crypto.randomBytes(8); key = nonce + digest[0:24]\nverifyLicenseKey uses crypto.timingSafeEqual\nNever commit LICENSE_SECRET; no default in prod",
      "autoResize": true,
      "lineHeight": 1.25
    },
