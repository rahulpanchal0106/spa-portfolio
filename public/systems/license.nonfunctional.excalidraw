      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "RUNTIME TRUST BOUNDARY\nCustomer VM --register/validate/download--> License Admin --PAT--> GitHub Releases\nCI maintainer --build/pack/chunk/publish--> GitHub Releases (channel repo)\nSuper-admin UI --CRUD clients/licenses + history--> Mongo\nBoundary rule: tarball bytes never public on commercial path without validate=true\nOpen-source / direct GitHub install path (if any) is OUT OF SCOPE for this board",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RUNTIME TRUST BOUNDARY\nCustomer VM --register/validate/download--> License Admin --PAT--> GitHub Releases\nCI maintainer --build/pack/chunk/publish--> GitHub Releases (channel repo)\nSuper-admin UI --CRUD clients/licenses + history--> Mongo\nBoundary rule: tarball bytes never public on commercial path without validate=true\nOpen-source / direct GitHub install path (if any) is OUT OF SCOPE for this board",
      "autoResize": true,
      "lineHeight": 1.25
    },
