      "link": null,
      "locked": false,
      "text": "NFR-S1 Machine binding\nQuality: license usable only on registered hardware\nMechanism: License.findOne({ email, machineCode, status != revoked })\nMismatch -> fail + ValidationHistory \"hardware mismatch\"\nRegister binds machineCode at first successful register",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NFR-S1 Machine binding\nQuality: license usable only on registered hardware\nMechanism: License.findOne({ email, machineCode, status != revoked })\nMismatch -> fail + ValidationHistory \"hardware mismatch\"\nRegister binds machineCode at first successful register",
      "autoResize": true,
      "lineHeight": 1.25
