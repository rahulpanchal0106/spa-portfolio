      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "FR -> NFR TRACE\nF1 Auth          -> S6, R2, O1\nF2 Clients        -> S3, S4, O3\nF3 License        -> S1, S2, L1-L4\nF4 Assets         -> S5, S7, S8, D1-D6\nF5 Audit/cron     -> L1, D1, D5, O2\nF6 Installer      -> D2, O4, C4\nCI-1..CI-6        -> C1-C8\nE2E commercial    -> S4 + S5 + D* + C* (gate + integrity end-to-end)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FR -> NFR TRACE\nF1 Auth          -> S6, R2, O1\nF2 Clients        -> S3, S4, O3\nF3 License        -> S1, S2, L1-L4\nF4 Assets         -> S5, S7, S8, D1-D6\nF5 Audit/cron     -> L1, D1, D5, O2\nF6 Installer      -> D2, O4, C4\nCI-1..CI-6        -> C1-C8\nE2E commercial    -> S4 + S5 + D* + C* (gate + integrity end-to-end)",
      "autoResize": true,
      "lineHeight": 1.25
    },
