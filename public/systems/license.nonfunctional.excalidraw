      "link": null,
      "locked": false,
      "text": "NFR-S4 Revocation effectiveness\nQuality: day-2 kill-switch without redeploying customer VM\nMechanism: license/revoke | toggle-status; status revoked excluded from findOne\nauthorizeAssetDownload re-runs validateLicense every download\nNo long-lived unsigned CDN URL for gated assets",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NFR-S4 Revocation effectiveness\nQuality: day-2 kill-switch without redeploying customer VM\nMechanism: license/revoke | toggle-status; status revoked excluded from findOne\nauthorizeAssetDownload re-runs validateLicense every download\nNo long-lived unsigned CDN URL for gated assets",
      "autoResize": true,
      "lineHeight": 1.25
