      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "NFR PRINCIPLE\nCommercial path: no HireTrack tarball bytes without passing validateLicense / authorizeAssetDownload.\nOpen catalog (version/list) may list releases; download endpoints must remain entitlement-gated.\nCI must publish integrity-checkable artifacts (sha256 + chunks) that License Admin and installer can verify.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NFR PRINCIPLE\nCommercial path: no HireTrack tarball bytes without passing validateLicense / authorizeAssetDownload.\nOpen catalog (version/list) may list releases; download endpoints must remain entitlement-gated.\nCI must publish integrity-checkable artifacts (sha256 + chunks) that License Admin and installer can verify.",
      "autoResize": true,
      "lineHeight": 1.25
    },
